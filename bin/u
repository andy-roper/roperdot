#!/usr/bin/env python3

import argparse
import fnmatch
import os
import re
import sys
from concurrent.futures import ProcessPoolExecutor

def make_glob_matcher(glob):
    if glob is None:
        return None
    return re.compile(fnmatch.translate(glob), re.IGNORECASE)


def list_subdirs(path):
    try:
        with os.scandir(path) as it:
            return [e.name for e in it if e.is_dir(follow_symlinks=False)]
    except OSError:
        return []


def immediate_size(path, glob_re, verbose):
    total = 0
    lines = []
    try:
        with os.scandir(path) as it:
            for e in it:
                if e.is_file(follow_symlinks=False):
                    if glob_re is None or glob_re.match(e.name):
                        try:
                            sz = e.stat(follow_symlinks=False).st_size
                        except OSError:
                            continue
                        total += sz
                        if verbose:
                            lines.append(f"{sz} {e.path}")
    except OSError:
        pass
    return total, lines

def recursive_size(path, glob_re, verbose):
    total = 0
    lines = []
    try:
        with os.scandir(path) as it:
            for e in it:
                try:
                    if e.is_dir(follow_symlinks=False):
                        sub_total, sub_lines = recursive_size(e.path, glob_re, verbose)
                        total += sub_total
                        lines.extend(sub_lines)
                    elif e.is_file(follow_symlinks=False):
                        if glob_re is None or glob_re.match(e.name):
                            sz = e.stat(follow_symlinks=False).st_size
                            total += sz
                            if verbose:
                                lines.append(f"{sz} {e.path}")
                except OSError:
                    continue
    except OSError:
        pass
    return total, lines


def compute_item(item, glob_re, verbose):
    name, path, kind = item
    if kind == "dot":
        size, lines = immediate_size(path, glob_re, verbose)
    else:
        size, lines = recursive_size(path, glob_re, verbose)
    return name, size, lines

def discover_items(target_dir, recurse, current_only):
    items = [(".", target_dir, "dot")]
    if current_only:
        return items
    for child in list_subdirs(target_dir):
        child_path = os.path.join(target_dir, child)
        if recurse:
            items.append((f"{child}/.", child_path, "dot"))
            for gc in list_subdirs(child_path):
                items.append((f"{child}/{gc}", os.path.join(child_path, gc), "recursive"))
        else:
            items.append((child, child_path, "recursive"))
    return items


def commify(n):
    return f"{n:,}"


def human_readable(n):
    suffixes = ["", "K", "M", "G", "T", "P", "E"]
    idx = 0
    n = float(n)
    while n >= 1024 and idx < len(suffixes) - 1:
        n /= 1024
        idx += 1
    if idx > 0 and n < 10:
        return f"{n:.1f}{suffixes[idx]}"
    return f"{int(n)}{suffixes[idx]}"


def format_number(n, human):
    return human_readable(n) if human else commify(n)

def parse_target(arg):
    if "*" in arg:
        if "/" in arg:
            d, g = arg.rsplit("/", 1)
            return (d or "."), g
        return ".", arg
    return arg, None


def build_arg_parser():
    p = argparse.ArgumentParser(add_help=False)
    p.add_argument("-a", "--asc", action="store_true")
    p.add_argument("-c", "--current", action="store_true")
    p.add_argument("-d", "--desc", action="store_true")
    p.add_argument("-f", "--full", action="store_true")
    p.add_argument("-h", "--human", action="store_true")
    p.add_argument("-p", "--parallel", action="store_true")
    p.add_argument("-r", "--recurse", action="store_true")
    p.add_argument("-t", "--terse", action="store_true")
    p.add_argument("-v", "--verbose", action="store_true")
    p.add_argument("-z", "--zero", action="store_true")
    p.add_argument("--help", "-?", action="store_true", dest="need_help")
    p.add_argument("target", nargs="?", default=".")
    return p

def show_help():
    print("""u: show size in bytes for files
Usage: u [OPTION] ... [FILE]

Options:
-a, --asc       Sort output in ascending size order; implies --parallel
-c, --current   Process only files in the current directory
-d, --desc      Sort output in descending size order; implies --parallel
-f, --full      Full path
-h, --human     Show output in human-readable format
-p, --parallel  Compute sizes concurrently; output is buffered until done
-r, --recurse   Process child directories of target
-t, --terse     Omit grand total
-v, --verbose   Print diagnostic information
-z, --zero      Suppress zero-byte directories

u will show the size in bytes of the files (or for the current directory
by default). If a directory is specified, sizes will be listed for the
directory and each of its subdirectories.""")

def main():
    args = build_arg_parser().parse_args()
    if args.need_help:
        show_help()
        return

    target_dir, glob = parse_target(args.target)
    if not os.path.isdir(target_dir):
        show_help()
        sys.exit(1)

    glob_re = make_glob_matcher(glob)
    sort_by_size = args.asc or args.desc
    parallel = args.parallel or sort_by_size
    human = args.human

    dir_prefix = (os.path.abspath(target_dir) + "/") if args.full else None

    def display_name(name):
        return (dir_prefix + name) if dir_prefix else name

    items = discover_items(target_dir, args.recurse, args.current)
    items.sort(key=lambda t: t[0].lower())

    fixed_fmt = "%4s  %s" if human else "%15s  %s"

    def emit(fmt, name, size, lines):
        for ln in lines:
            print(ln)
        print(fmt % (format_number(size, human), display_name(name)))

    total = 0
    if not parallel:
        for item in items:
            name, size, lines = compute_item(item, glob_re, args.verbose)
            total += size
            if not (args.zero and size == 0):
                emit(fixed_fmt, name, size, lines)
        if not args.terse:
            print(fixed_fmt % (format_number(total, human), "TOTAL"))
        return

    results = []
    with ProcessPoolExecutor() as ex:
        futs = [ex.submit(compute_item, item, glob_re, args.verbose) for item in items]
        for fut in futs:
            results.append(fut.result())
    total = sum(r[1] for r in results)

    if sort_by_size:
        results.sort(key=lambda r: r[1], reverse=args.desc)
    else:
        results.sort(key=lambda r: r[0].lower())

    shown = [r for r in results if not (args.zero and r[1] == 0)]
    formatted_total = format_number(total, human)
    widths = [len(format_number(r[1], human)) for r in shown] + [len(formatted_total)]
    width = max(widths) if widths else len(formatted_total)
    dyn_fmt = f"%{width}s  %s"

    for name, size, lines in shown:
        emit(dyn_fmt, name, size, lines)
    if not args.terse:
        print(dyn_fmt % (formatted_total, "TOTAL"))


if __name__ == "__main__":
    main()
