#!/usr/bin/env python3
"""
Description: Compares two directories for differing and unique files

Author: Andy Roper <andyroper42@gmail.com>
URL: https://github.com/andy-roper/roperdot
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

import fsutil


def parse_args():
    p = argparse.ArgumentParser(
        prog="dirdiff",
        description="Compare two directories for differing and unique files.",
    )
    p.add_argument("dir_1")
    p.add_argument("dir_2", nargs="?", default=None)
    p.add_argument("-f", "--full", action="store_true",
                    help="print full paths for unique files (relative paths are the default)")
    p.add_argument("-i", "--ignore", action="store_true", help="ignore file I/O errors")
    p.add_argument("-r", "--recurse", action="store_true", help="recurse into subdirectories")
    p.add_argument("-s", "--suppress", action="store_true", help="ignore and suppress file I/O errors")
    p.add_argument("-t", "--trim", action="store_true", help="trim output (no section headings)")
    p.add_argument("-u", "--unique", type=int, choices=(1, 2), default=None,
                    help="list only unique entries for the specified directory (1 or 2)")
    p.add_argument("-v", "--verbose", action="store_true", help="verbose output")
    return p.parse_args()

def index_dir(root: str, recurse: bool, windows: bool, verbose: bool, label: str) -> dict:
    """Return {lookup_key: relative_path} for every file under root."""
    files = {}
    for f in fsutil.walk_files(root, recurse=recurse):
        rel = str(f)[len(root) + 1:]
        key = rel.lower() if windows else rel
        files[key] = rel
        if verbose:
            print(f"file in {label}: {rel}", file=sys.stderr)
    return files


def main():
    args = parse_args()
    dir_1 = fsutil.fix_path(args.dir_1)
    dir_2 = fsutil.fix_path(args.dir_2) if args.dir_2 else fsutil.fix_path(str(Path.cwd()))
    windows = fsutil.IS_WINDOWS

    for label, d in (("dir_1", dir_1), ("dir_2", dir_2)):
        if not Path(d).is_dir():
            print(f"Unable to open {d}", file=sys.stderr)
            if not (args.ignore or args.suppress):
                sys.exit(1)

    files_1 = index_dir(dir_1, args.recurse, windows, args.verbose, "dir 1")
    files_2 = index_dir(dir_2, args.recurse, windows, args.verbose, "dir 2")

    common_keys = set(files_1) & set(files_2)
    diff_files = []

    if not args.unique and common_keys:
        # Only hash pairs whose sizes match; mismatched sizes are automatic diffs.
        to_hash = []
        pairs = []
        for key in common_keys:
            f1_full = f"{dir_1}/{files_1[key]}"
            f2_full = f"{dir_2}/{files_2[key]}"
            try:
                size_1 = fsutil.get_size(f1_full)
                size_2 = fsutil.get_size(f2_full)
            except OSError:
                diff_files.append(files_1[key])
                continue
            if size_1 != size_2:
                diff_files.append(files_1[key])
                continue
            pairs.append((key, f1_full, f2_full))
            to_hash.extend((f1_full, f2_full))

        on_error = "silent" if args.suppress else ("warn" if args.ignore else "raise")
        hashes = fsutil.hash_files_parallel(to_hash, on_error=on_error)
        for key, f1_full, f2_full in pairs:
            md5_1 = hashes.get(f1_full)
            md5_2 = hashes.get(f2_full)
            if md5_1 is None or md5_2 is None:
                continue
            if md5_1 != md5_2:
                diff_files.append(files_1[key])

    for key in common_keys:
        files_1.pop(key, None)
        files_2.pop(key, None)

    if diff_files and not args.unique:
        print("Files differing between directories:")
        for name in sorted(diff_files, key=str.lower):
            print(name)
        print()

    if files_1 and args.unique != 2:
        if not args.trim or not args.unique:
            print(f"Files unique to {dir_1}")
        prefix = f"{dir_1}/" if args.full else ""
        for key in sorted(files_1):
            print(prefix + files_1[key])
        if not args.unique:
            print()

    if files_2 and args.unique != 1:
        if not args.trim or not args.unique:
            print(f"Files unique to {dir_2}")
        prefix = f"{dir_2}/" if args.full else ""
        for key in sorted(files_2):
            print(prefix + files_2[key])
        if not args.unique:
            print()


if __name__ == "__main__":
    main()
