#   If printing and one or more arguments are info files, read their contents into memory
#   If a file path is processed and that file path already exists in memory from the info file,
#   get the MD5 of the file; if it differs, remove the old MD5 entry from memory and create a new one
#   This will require a map by path
#   Could use switch to ignore existing, i.e. don't calculate MD5 if the file already exists
#   Would want to remove a file from the list if the file doesn't physically exist: this would be done if a
#   volume is specified and it matches
#   What if a file was renamed? Any way to handle besides a full scan?

from __future__ import annotations

import argparse
import os
import sys
from collections import defaultdict
from pathlib import Path

import fsutil


class FileGroup:
    __slots__ = ("path", "mask", "delete_dupes", "is_hash_file")

    def __init__(self, path, delete_dupes):
        self.path = path
        self.mask = None
        self.delete_dupes = delete_dupes
        self.is_hash_file = False

def parse_args():
    p = argparse.ArgumentParser(
        prog="dc",
        description="Compare directories by content and report (or delete) duplicate files.",
    )
    p.add_argument("paths", nargs="*", help="directories, file masks, or hash-info files to compare")
    p.add_argument("-d", "--delete", action="append", default=[], metavar="DIR",
                    help="flag a directory's duplicate files for deletion (repeatable)")
    p.add_argument("-o", "--other", action="store_true",
                    help="only report duplicates that span more than one file group")
    p.add_argument("-p", "--print", dest="printing", action="store_true",
                    help="print size/md5/path for each file instead of comparing")
    p.add_argument("-s", "--suppress", action="store_true",
                    help="with --delete, show what would be deleted without deleting")
    p.add_argument("-r", "--recurse", action="store_true", help="recurse into subdirectories")
    p.add_argument("-v", "--verbose", action="store_true", help="verbose output")
    p.add_argument("--volume", metavar="NAME",
                    help="with --print, use this volume name instead of the base path")
    args = p.parse_args()
    if args.delete and not args.paths:
        p.error("when using --delete you must include at least one directory not flagged for deletion")
    return args

def build_file_groups(args) -> list:
    groups = [FileGroup(path, False) for path in args.paths]
    groups += [FileGroup(path, True) for path in args.delete]
    if not groups:
        groups = [FileGroup(str(Path.cwd()), False)]
    for g in groups:
        directory, mask = fsutil.split_path_mask(g.path)
        g.path = directory
        g.mask = mask
        g.is_hash_file = not Path(directory).is_dir()
    if args.other and len(groups) < 2:
        print("Error: --other requires more than one file group", file=sys.stderr)
        sys.exit(1)
    return groups


def do_print(groups, recurse, volume, verbose):
    for idx, g in enumerate(groups):
        if not Path(g.path).is_dir():
            print(f"Error: directory argument required when printing: {g.path}", file=sys.stderr)
            sys.exit(1)
        files = list(fsutil.walk_files(g.path, recurse=recurse, mask=g.mask))
        if verbose:
            print(f"Group {idx}: hashing {len(files)} files under {g.path}", file=sys.stderr)
        hashes = fsutil.hash_files_parallel(files, on_error="warn")
        for f in sorted(files):
            size = fsutil.get_size(f)
            md5 = hashes.get(str(f))
            rel = str(f)[len(g.path) + 1:]
            shown = f"{volume}/{rel}" if volume else str(f)
            print(f"{size}\t{md5}\t{shown}")

def build_file_info(groups, recurse, verbose):
    """Return {size: [ {name, fg_index, md5(optional)} ]}."""
    file_info = defaultdict(list)
    for fg_index, g in enumerate(groups):
        if verbose:
            print(f"Processing group {fg_index}: {g.path}", file=sys.stderr)
        if g.is_hash_file:
            load_hash_info_file(g.path, fg_index, file_info)
            continue
        for f in fsutil.walk_files(g.path, recurse=recurse, mask=g.mask):
            size = fsutil.get_size(f)
            if not size:
                continue
            file_info[size].append({"name": str(f), "fg_index": fg_index})
    return file_info


def load_hash_info_file(path, fg_index, file_info):
    """Expected line format: size<TAB>md5<TAB>path"""
    with open(path, "r", encoding="utf-8", errors="replace") as f:
        for line in f:
            parts = line.rstrip("\n").split(None, 2)
            if len(parts) != 3:
                continue
            size, md5, name = parts
            file_info[int(size)].append({"name": name, "fg_index": fg_index, "md5": md5})

def find_duplicates(file_info, groups, only_other, deleting, suppress, verbose):
    # Hash every candidate file across every size-group in one parallel
    # batch, rather than one small batch per size-group.
    to_hash = [
        e["name"]
        for entries in file_info.values() if len(entries) > 1
        for e in entries if "md5" not in e
    ]
    if verbose:
        print(f"Hashing {len(to_hash)} candidate files for duplicate detection", file=sys.stderr)
    hashes = fsutil.hash_files_parallel(to_hash, on_error="warn")

    for size, entries in sorted(file_info.items()):
        if len(entries) < 2:
            continue
        if only_other and len({e["fg_index"] for e in entries}) < 2:
            continue

        by_md5 = defaultdict(list)
        for e in entries:
            md5 = e.get("md5") or hashes.get(e["name"])
            if md5 is not None:
                by_md5[md5].append(e)

        for dupes in by_md5.values():
            if len(dupes) > 1:
                report_duplicate_group(dupes, groups, deleting, suppress)

def report_duplicate_group(dupes, groups, deleting, suppress):
    if deleting:
        to_delete = [e["name"] for e in dupes if groups[e["fg_index"]].delete_dupes]
        to_keep = [e["name"] for e in dupes if not groups[e["fg_index"]].delete_dupes]
        if to_keep:
            line_parts = list(to_keep)
            for name in to_delete:
                line_parts.append(f"{name} (deleted)")
                if not suppress:
                    try:
                        os.unlink(name)
                    except OSError as e:
                        print(f"Error deleting {name}: {e}", file=sys.stderr)
            print("\t".join(line_parts))
            return
    print("\t".join(e["name"] for e in dupes))


def main():
    args = parse_args()
    groups = build_file_groups(args)
    deleting = bool(args.delete)

    if args.printing:
        do_print(groups, args.recurse, args.volume, args.verbose)
        return

    file_info = build_file_info(groups, args.recurse, args.verbose)
    find_duplicates(file_info, groups, args.other, deleting, args.suppress, args.verbose)


if __name__ == "__main__":
    main()
