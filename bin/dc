#!/usr/bin/env python3
"""
Description: Compare directories (or files of pre-computed hashes) and report or delete duplicate files

Author: Andy Roper <andyroper42@gmail.com>
URL: https://github.com/andy-roper/roperdot

Deletion safety note: when --delete is used, matching duplicate files ARE
removed immediately unless --suppress (dry-run) is also given. There is no
confirmation prompt: this matches the original script's behavior.
"""

# TO DO
