#!/usr/bin/env python3
"""
Description: Syncs the files in a source directory with a target directory

Author: Andy Roper <andyroper42@gmail.com>
URL: https://github.com/andy-roper/roperdot

Comparison is based on modification time (not content hashing).

Deletion safety note: files present in the target but not in the source ARE
deleted immediately once sync runs, unless --nocopy (display-only mode) is
given. There is no confirmation prompt — this matches the original script's
behavior.
"""

from __future__ import annotations

import argparse
import os
import re
import sys
from pathlib import Path

import fsutil

DB_FILE_PATTERN = re.compile(r"\.db$", re.IGNORECASE)

def parse_args():
    p = argparse.ArgumentParser(
        prog="syncdir",
        description="Synchronize a target directory with a source directory.",
    )
    p.add_argument("src_dir", nargs="?", help="source directory")
    p.add_argument("target_dir", nargs="?", help="target directory")
    p.add_argument("-d", "--disable", action="store_true", help="disable directory recursion")
    p.add_argument("-f", "--force", action="store_true",
                    help="always copy files present in both dirs, ignoring mtime comparison")
    p.add_argument("-n", "--nocopy", action="store_true", help="display only; make no changes")
    p.add_argument("-p", "--print", dest="print_volume", metavar="VOLUME",
                    help="print file/mtime data for target_dir tagged with VOLUME, then exit")
    p.add_argument("-o", "--output", dest="output_dir",
                    help="write new/changed files here instead of into target_dir")
    p.add_argument("-t", "--target-data", dest="target_data_file",
                    help="a data file (from a previous --print run) describing files on other volumes")
    p.add_argument("--xdir", action="append", default=[], dest="exclude_dirs",
                    help="a directory to exclude (repeatable)")
    p.add_argument("--xpattern", dest="exclude_pattern", help="a filename regex to exclude")
    p.add_argument("-v", "--verbose", action="store_true", help="verbose output")
    args = p.parse_args()

    if args.print_volume:
        if not args.src_dir:
            p.error("--print requires a directory argument")
    elif not args.src_dir or not args.target_dir:
        p.error("src_dir and target_dir are required (unless using --print)")
    return args

def do_print_mode(target_dir, volume, exclude_dirs, exclude_pattern, recurse):
    target_dir = fsutil.fix_path(target_dir)
    if not Path(target_dir).is_dir():
        print(f"Error: {target_dir} does not exist", file=sys.stderr)
        sys.exit(1)
    for f in fsutil.walk_files(
        target_dir, recurse=recurse, exclude_dirs=exclude_dirs,
        exclude_pattern=exclude_pattern, skip_pattern=DB_FILE_PATTERN,
    ):
        rel = str(f)[len(target_dir) + 1:]
        mtime = fsutil.get_mtime(f)
        print(f"{volume}\t{rel}\t{mtime}")


def load_target_data_file(path):
    """Data file format: volume<TAB>relPath<TAB>modTime, from a previous --print run."""
    target_hash = {}
    with open(path, "r", encoding="utf-8", errors="replace") as f:
        for line in f:
            parts = line.rstrip("\n").split("\t")
            if len(parts) != 3:
                continue
            volume, rel_path, mod_time = parts
            target_hash[rel_path] = {
                "volume": volume, "mod_time": float(mod_time), "in_output_dir": False,
            }
    return target_hash


def index_target_dir(root, recurse, exclude_dirs, exclude_pattern, in_output_dir, target_hash):
    for f in fsutil.walk_files(
        root, recurse=recurse, exclude_dirs=exclude_dirs,
        exclude_pattern=exclude_pattern, skip_pattern=DB_FILE_PATTERN,
    ):
        rel = str(f)[len(root) + 1:]
        target_hash[rel] = {"volume": "", "mod_time": None, "in_output_dir": in_output_dir}

def main():
    args = parse_args()
    exclude_dirs = {fsutil.fix_path(d).lower() for d in args.exclude_dirs}
    exclude_pattern = re.compile(args.exclude_pattern) if args.exclude_pattern else None
    recurse = not args.disable
    verbose = args.verbose or args.nocopy

    if args.print_volume:
        do_print_mode(args.src_dir, args.print_volume, exclude_dirs, exclude_pattern, recurse)
        return

    src_dir = fsutil.fix_path(args.src_dir)
    target_dir = fsutil.fix_path(args.target_dir)
    output_dir = fsutil.fix_path(args.output_dir) if args.output_dir else None

    if not Path(target_dir).is_dir():
        print(f"Error: {target_dir} does not exist", file=sys.stderr)
        sys.exit(1)
    if not Path(src_dir).exists():
        print(f"Error: {src_dir} does not exist", file=sys.stderr)
        sys.exit(1)

    exclude_dirs.add(f"{src_dir}/system volume information".lower())
    exclude_dirs.add(f"{src_dir}/$recycle.bin".lower())

    target_hash = load_target_data_file(args.target_data_file) if args.target_data_file else {}

    src_files = [
        str(f)[len(src_dir) + 1:]
        for f in fsutil.walk_files(
            src_dir, recurse=recurse, exclude_dirs=exclude_dirs,
            exclude_pattern=exclude_pattern, skip_pattern=DB_FILE_PATTERN,
        )
    ]

    index_target_dir(target_dir, recurse, exclude_dirs, exclude_pattern, False, target_hash)
    if output_dir:
        index_target_dir(output_dir, recurse, exclude_dirs, exclude_pattern, True, target_hash)

    to_copy: list[tuple[str, str]] = []
    remote_copy_notes: list[str] = []

    for rel in src_files:
        entry = target_hash.pop(rel, None)
        src_file = f"{src_dir}/{rel}"
        if entry is None:
            dest_root = output_dir or target_dir
            to_copy.append((src_file, f"{dest_root}/{rel}"))
            continue

        dest_root = output_dir if entry["in_output_dir"] else target_dir
        target_file = f"{dest_root}/{rel}"
        if args.force:
            to_copy.append((src_file, target_file))
            continue

        target_mtime = entry["mod_time"]
        if target_mtime is None:
            try:
                target_mtime = fsutil.get_mtime(target_file)
            except OSError:
                target_mtime = 0
        src_mtime = fsutil.get_mtime(src_file)
        if src_mtime > target_mtime:
            if entry["volume"]:
                remote_copy_notes.append(
                    f'Need to copy "{src_file}" to {entry["volume"]} and update the target data file'
                )
            else:
                to_copy.append((src_file, target_file))

    for note in remote_copy_notes:
        print(note)

    if verbose:
        print(f"Copying {len(to_copy)} file(s)" + (" (display only)" if args.nocopy else ""))
    if to_copy and not args.nocopy:
        errors = fsutil.copy_files_parallel(to_copy, verbose=verbose)
        if errors:
            print(f"{len(errors)} file(s) failed to copy", file=sys.stderr)
    elif to_copy and args.nocopy:
        for src_file, target_file in to_copy:
            print(f"Would copy {src_file} -> {target_file}")

    for rel, entry in target_hash.items():
        if entry["volume"]:
            print(f'Need to delete "{src_dir}/{rel}" from {entry["volume"]} and update the target data file')
            continue
        dest_root = output_dir if entry["in_output_dir"] else target_dir
        target_file = f"{dest_root}/{rel}"
        if args.nocopy:
            print(f"Would delete {target_file}")
        else:
            if verbose:
                print(f"Deleting {target_file}")
            try:
                os.unlink(target_file)
            except OSError as e:
                print(f"Error deleting {target_file}: {e}", file=sys.stderr)


if __name__ == "__main__":
    main()
